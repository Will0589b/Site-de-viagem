!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>ExploreMundo</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>


<header>
  <div class="logo"><span>Explore</span>Mundo</div>
  <nav>
    <a href="index.html">Início</a>
    <a href="destinos.html">Destinos</a>
    <a href="#">Sobre</a>
    <a href="#">Contato</a>
  </nav>
</header>


<section class="hero">
  <div class="hero-text">
    <h1>Descubra Lugares Incríveis!</h1>
    <p>Explore os melhores destinos ao redor do mundo.</p>
    <a href="destinos.html" class="btn">Saiba Mais</a>
  </div>
</section>


<section class="destinos">
  <h2>Destinos Populares</h2>

  <div class="cards">
    <div class="card">
      <img src="tropical-beach-with-white-sand.jpg">
      <h3>Praias Paradisíacas</h3>
      <p>Conheça as mais belas praias</p>
    </div>

    <div class="card">
      <img src="breathtaking-view-snowy-mountains-cloudy-sky-patagonia-chile.jpg">
      <h3>Montanhas</h3>
      <p>Aventuras nas alturas</p>
    </div>

    <div class="card">
      <img src="Cidades-Historicas-770x515.jpg">
      <h3>Cidades Históricas</h3>
      <p>Explore a cultura e história</p>
    </div>
  </div>

  <a href="destinos.html" class="btn">Ver Mais Destinos</a>
</section>


<section class="sobre">
  <h2>Sobre Nós</h2>
  <p>Somos apaixonados por viagens e queremos ajudar você a explorar o mundo!</p>
</section>


<section class="contato">
  <div class="form">
    <h3>Fale Conosco</h3>
    <input type="text" placeholder="Nome">
    <input type="email" placeholder="E-mail">
    <textarea placeholder="Mensagem"></textarea>
    <button>Enviar</button>
  </div>

  <div class="info">
    <h3>Onde Estamos</h3>
    <img src="Captura de tela 2026-03-25 094551.png">
    <p>📧 contato@exploremundo.com</p>
    <p>📞 (11) 1234-5678</p>
  </div>
</section>

<footer>
  © 2024 ExploreMundo - Todos os direitos reservados
</footer>

</body>
</html>

